{
  "name": "madeireira-sol-nascente",
  "productName": "Madeireira Sol Nascente",
  "version": "1.0.0",
  "description": "Sistema de gestão da Madeireira Sol Nascente",
  "author": {
    "name": "Madeireira Sol Nascente",
    "email": "cesarmartinstaborda@gmail.com"
  },
  "homepage": "https://madeireira-sol-nascente.local",
  "desktopName": "madeireira-sol-nascente",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@tailwindcss/vite": "^5.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "br.com.madeireirasolnascente.app",
    "productName": "Madeireira Sol Nascente",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "pacman",
        "AppImage"
      ],
      "category": "Office",
      "executableName": "madeireira-sol-nascente",
      "icon": "build/icons",
      "syncDesktopName": true,
      "maintainer": "cesarmartinstaborda@gmail.com",
      "artifactName": "Madeireira-Sol-Nascente-${version}-${arch}.${ext}"
    }
  }
}
