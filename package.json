{
  "name": "madeireira-sol-nascente",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de gestão operacional da Madeireira Sol Nascente",
  "main": "electron.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"npx electron .\"",
    "electron:build": "npm run dist:rpm",
    "dist:linux": "npm run dist:rpm",
    "dist:rpm": "npm run build && node scripts/build-rpm.cjs",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "test": "vitest run",
    "dist:rpm:fedora": "bash scripts/build-rpm-fedora.sh",
    "verify:rpm:fedora": "bash scripts/verify-rpm-fedora.sh"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.1.2",
    "electron": "44.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.madeireirasolnascente.app",
    "productName": "Madeireira Sol Nascente",
    "artifactName": "Madeireira-Sol-Nascente-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "package.json",
      "assets/icon.png"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "synopsis": "Gestão operacional da Madeireira Sol Nascente",
      "description": "Sistema desktop para gestão operacional da Madeireira Sol Nascente",
      "vendor": "Madeireira Sol Nascente",
      "maintainer": "Madeireira Sol Nascente",
      "artifactName": "Madeireira-Sol-Nascente-${version}-${arch}.${ext}"
    },
    "rpm": {
      "compression": "xz",
      "packageCategory": "Office",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "alsa-lib",
        "mesa-libgbm",
        "libsecret"
      ]
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "core-js@3.50.0": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  },
  "homepage": "https://github.com/cesarmartinstaborda-bit/madeireira-sol-nascente",
  "author": "Madeireira Sol Nascente"
}
